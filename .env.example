# Copy to .env and fill in. .env is gitignored -- never commit real tokens.

# ESIOS (REE). Request by emailing consultasios@ree.es for a personal API
# token. Used as the `x-api-key` header.
ESIOS_TOKEN=

# ENTSO-E Transparency Platform. Register at https://transparency.entsoe.eu,
# then email transparency@entsoe.eu from the registered address to request
# API access; the token then appears in your account settings.
ENTSOE_TOKEN=
