# Environment
.venv/
__pycache__/
*.pyc
.env

# Data: large and re-fetchable via scripts/fetch_*.py
data/**
!data/**/.gitkeep
!data/README.md

# Papers: the PDFs are third-party copyrighted material and the Markdown is
# regenerable with scripts/build/convert_papers.py. Keep the README only.
papers/**
!papers/README.md

# Large derived analysis tables (re-derivable from scripts/analysis/)
outputs/tables/*.parquet

# macOS
.DS_Store

# R
.Rhistory
.RData
.Rproj.user/

# LaTeX build intermediates (regenerable via slides/build-tex.sh)
*.aux
*.nav
*.snm
*.toc
*.out
slides/*.log
